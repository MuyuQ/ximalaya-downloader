{
  "manifest_version": 3,
  "name": "Ximalaya Credential Helper",
  "version": "0.1.0",
  "permissions": ["cookies", "webRequest", "storage"],
  "host_permissions": ["https://*.ximalaya.com/*", "https://*.xmcdn.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "获取凭证" }
}
